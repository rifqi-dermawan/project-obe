datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Model Tabel Jadwal untuk Analisis Decision Tree (Schedule)
model Schedule {
  id         Int      @id @default(autoincrement())
  subject    String   @map("mataKuliah")
  lecturer   String   @map("dosen")
  class      String   @default("-") @map("kelas")
  room       String   @map("ruangan")
  time       String   @map("waktu")
  status     String   @default("Aman") 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("jadwal") 
}

// Model Tabel Ruangan (Room)
model Room {
  id          Int      @id @default(autoincrement())
  name        String   @map("nama")
  type        String   @default("KELAS") @map("tipe") // Penanda khusus: "KELAS" atau "LAB"
  capacity    Int      @map("kapasitas")
  facilities  String   @map("fasilitas")
  status      String   @default("Tersedia")
  qrCodeUrl   String?  // Disiapkan untuk menyimpan URL/Token unik QR Code ruangan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ruangan")
}

// Model Tabel Dosen (Lecturer)
model Lecturer {
  id        Int      @id @default(autoincrement())
  name      String   @map("nama")
  nip       String
  expertise String   @map("keahlian")
  contact   String   @map("kontak")
  requestLab Boolean  @default(false) @map("mintaLab") // Penanda apakah dosen ini menginginkan ruang Lab
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dosen")
}

// Model Tabel Pengaturan (Settings)
model Settings {
  id                Int      @id @default(1) // Hanya satu baris pengaturan
  institutionName   String   @default("Universitas Pancasakti Tegal") @map("namaInstitusi")
  academicYear      String   @default("2026/2027") @map("tahunAkademik")
  semester          String   @default("Ganjil")
  emailNotification Boolean  @default(true) @map("notifikasiEmail")
  appTheme          String   @default("system") @map("temaAplikasi")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pengaturan")
}

// Enum untuk Role Based Access Control (RBAC)
enum Role {
  SUPERADMIN
  ADMIN_KELAS
  ADMIN_LAB
}

// Model untuk Autentikasi (Kompatibel dengan NextAuth / Better Auth)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // Jika menggunakan kredensial email/password
  image         String?
  role          Role      @default(ADMIN_KELAS)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}