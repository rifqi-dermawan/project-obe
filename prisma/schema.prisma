datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Model Tabel Jadwal untuk Analisis Decision Tree
model Jadwal {
  id         Int      @id @default(autoincrement())
  mataKuliah String
  dosen      String
  kelas      String   @default("-")
  ruangan    String
  waktu      String
  status     String   @default("Aman") 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("jadwal") 
}

// Model Tabel Ruangan
model Ruangan {
  id          Int      @id @default(autoincrement())
  nama        String
  tipe        String   @default("KELAS") // Penanda khusus: "KELAS" atau "LAB"
  kapasitas   Int
  fasilitas   String
  status      String   @default("Tersedia")
  qrCodeUrl   String?  // Disiapkan untuk menyimpan URL/Token unik QR Code ruangan
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ruangan")
}

// Model Tabel Dosen
model Dosen {
  id        Int      @id @default(autoincrement())
  nama      String
  nip       String
  keahlian  String
  kontak    String
  mintaLab  Boolean  @default(false) // Penanda apakah dosen ini menginginkan ruang Lab
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dosen")
}

// Model Tabel Pengaturan
model Pengaturan {
  id                Int      @id @default(1) // Hanya satu baris pengaturan
  namaInstitusi     String   @default("Universitas Pancasakti Tegal")
  tahunAkademik     String   @default("2026/2027")
  semester          String   @default("Ganjil")
  notifikasiEmail   Boolean  @default(true)
  temaAplikasi      String   @default("system")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("pengaturan")
}

// Enum untuk Role Based Access Control (RBAC)
enum Role {
  SUPERADMIN
  ADMIN_KELAS
  ADMIN_LAB
}

// Model untuk Autentikasi (Kompatibel dengan NextAuth / Better Auth)
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?   // Jika menggunakan kredensial email/password
  image         String?
  role          Role      @default(ADMIN_KELAS)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}